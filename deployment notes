# 1. Rebuild the 3 container images with your updated code
docker build -t shiftsync-frontend:v1 ./frontend
docker build -t shiftsync-backend:v1 ./backend
docker build -t shiftsync-ml:v1 ./ml-service

# 2. Force Kubernetes to restart the pods and load the new images
kubectl rollout restart deployment/shiftsync-frontend-deployment
kubectl rollout restart deployment/shiftsync-backend-deployment
kubectl rollout restart deployment/shiftsync-ml-deployment

kubectl apply -f k8s/01-secrets.yaml
kubectl apply -f k8s/02-pvc.yaml
kubectl apply -f k8s/03-ml-service.yaml
kubectl apply -f k8s/04-backend.yaml
kubectl apply -f k8s/05-frontend.yaml

kubectl get pods

kubectl port-forward service/shiftsync-frontend-service 8080:80


# 1. Rebuild all three images
docker build --no-cache -t shiftsync-frontend:v1 ./frontend
docker build --no-cache -t shiftsync-backend:v1 ./backend
docker build --no-cache -t shiftsync-ml:v1 ./ml-service

# 2. Clear old SQLite file so backend initializes with the updated multi-org schema
kubectl exec deployment/shiftsync-backend-deployment -- rm -f /app/data/shiftsync.sqlite

# 3. Restart all deployments
kubectl rollout restart deployment/shiftsync-frontend-deployment
kubectl rollout restart deployment/shiftsync-backend-deployment
kubectl rollout restart deployment/shiftsync-ml-deployment